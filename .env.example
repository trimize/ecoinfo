# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-3.8-flash, with automatic fallback to other Gemini models)
LLM_MODEL=

# Optional: without these the app stores data in .data/db.json (local dev only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared access code for the "Pro" plan (sync + AI generation). Required in production:
# without it, those actions are locked for everyone.
ACCESS_PASSWORD=

# Required for the daily Vercel cron (GET /api/ingest)
CRON_SECRET=
