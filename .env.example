# LLM provider: gemini (default, free tier) or anthropic
LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Only if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional model override (defaults: gemini-2.5-flash / claude-opus-5-5)
LLM_MODEL=

# Optional: without these the app stores data in .data/db.json (local dev only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: protects the GET /api/ingest cron endpoint on Vercel
CRON_SECRET=
