# LLM provider: gemini (default, free tier) or anthropic
LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Only if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional model override (defaults: gemini-3.8-flash / claude-opus-5-5)
LLM_MODEL=

# Optional: without these the app stores data in .data/db.json (local dev only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared access code for the "Pro" plan (sync + AI generation). Required in production:
# without it, those actions are locked for everyone.
ACCESS_PASSWORD=

# Required for the daily Vercel cron (GET /api/ingest)
CRON_SECRET=
